# Copie este archivo a `.env` (cp .env.example .env) y ajuste los valores.
# `.env` no se versiona: aquí solo van valores de EJEMPLO con los que el servicio arranca.

# Base de datos (SQLite local por defecto). Para otra ruta: sqlite:////ruta/absoluta/polizas.db
DATABASE_URL=sqlite:///./polizas.db

# Secreto con el que se firma el token interno de cada póliza.
# Cámbielo en cualquier entorno real; si no se define, el proceso genera uno efímero.
SECRETO_FIRMA=valor-de-ejemplo-cambiar-en-produccion

# Umbral de probabilidad a partir del cual /score marca alto_riesgo (entre 0 y 1).
UMBRAL_ALTO_RIESGO=0.6

# Opcional: ruta del modelo serializado (por defecto, modelo.pkl junto a main.py).
# RUTA_MODELO=modelo.pkl

# Opcional: clave del servicio de reaseguro (hoy ningún endpoint la usa).
# CLAVE_API_REASEGURO=
